# test_simple_calculator.py
import unittest
from simple_calculator import SimpleCalculator


class TestSimpleCalculator(unittest.TestCase):
    """Test cases for the SimpleCalculator class."""

    def setUp(self):
        """Create a fresh calculator instance before each test."""
        self.calc = SimpleCalculator()

    # ----------------------
    # Addition tests
    # ----------------------
    def test_add_positive_numbers(self):
        """Test addition with positive numbers."""
        self.assertEqual(self.calc.add(5, 3), 8)
        self.assertEqual(self.calc.add(10, 25), 35)

    def test_add_negative_numbers(self):
        """Test addition with negative numbers."""
        self.assertEqual(self.calc.add(-4, -7), -11)
        self.assertEqual(self.calc.add(-10, 5), -5)

    def test_add_zero(self):
        """Test addition involving zero."""
        self.assertEqual(self.calc.add(0, 0), 0)
        self.assertEqual(self.calc.add(7, 0), 7)
        self.assertEqual(self.calc.add(0, -3), -3)

    def test_add_large_numbers(self):
        """Test addition with relatively large numbers."""
        self.assertEqual(self.calc.add(999999, 1), 1000000)

    # ----------------------
    # Subtraction tests
    # ----------------------
    def test_subtract_positive_numbers(self):
        self.assertEqual(self.calc.subtract(10, 4), 6)
        self.assertEqual(self.calc.subtract(5, 8), -3)

    def test_subtract_negative_numbers(self):
        self.assertEqual(self.calc.subtract(-5, -3), -2)
        self.assertEqual(self.calc.subtract(-10, 5), -15)

    def test_subtract_zero(self):
        self.assertEqual(self.calc.subtract(8, 0), 8)
        self.assertEqual(self.calc.subtract(0, 5), -5)
        self.assertEqual(self.calc.subtract(0, 0), 0)

    # ----------------------
    # Multiplication tests
    # ----------------------
    def test_multiply_positive_numbers(self):
        self.assertEqual(self.calc.multiply(6, 7), 42)
        self.assertEqual(self.calc.multiply(5, 0), 0)

    def test_multiply_negative_numbers(self):
        self.assertEqual(self.calc.multiply(-4, 3), -12)
        self.assertEqual(self.calc.multiply(-5, -6), 30)

    def test_multiply_by_zero(self):
        self.assertEqual(self.calc.multiply(1000, 0), 0)
        self.assertEqual(self.calc.multiply(0, -999), 0)

    # ----------------------
    # Division tests
    # ----------------------
    def test_divide_normal_cases(self):
        """Test regular division cases."""
        self.assertEqual(self.calc.divide(10, 2), 5.0)
        self.assertEqual(self.calc.divide(7, 2), 3.5)
        self.assertAlmostEqual(self.calc.divide(1, 3), 0.3333333333333333, places=10)

    def test_divide_negative_numbers(self):
        self.assertEqual(self.calc.divide(-15, 3), -5.0)
        self.assertEqual(self.calc.divide(20, -4), -5.0)
        self.assertEqual(self.calc.divide(-12, -6), 2.0)

    def test_divide_by_zero(self):
        """Division by zero should return None according to the implementation."""
        self.assertIsNone(self.calc.divide(10, 0))
        self.assertIsNone(self.calc.divide(0, 0))
        self.assertIsNone(self.calc.divide(-25, 0))

    def test_divide_zero_by_number(self):
        """Zero divided by any non-zero number should be 0.0"""
        self.assertEqual(self.calc.divide(0, 5), 0.0)
        self.assertEqual(self.calc.divide(0, -8), 0.0)


if __name__ == '__main__':
    unittest.main()